PORT=5000
MONGODB_URI=
JWT_SECRET=

# System-level Super Admin (created on first startup if it does not exist)
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Support user created automatically inside every organization. Its email is derived per organization:
# SUPPORT_USER_EMAIL=support@example.com becomes support+<companyRoute>@example.com (e.g. support+acme@example.com)
SUPPORT_USER_NAME=
SUPPORT_USER_EMAIL=
SUPPORT_USER_PASSWORD=
